<odoo>
  <data>
    <!-- VISTA workshop -->
    <record id="view_workshop_search" model="ir.ui.view">
      <field name="name">workshop.search.view</field>
      <field name="model">workshop.workshop</field>
      <field name="arch" type="xml">
          <search string="Order Search">
              <filter string="Warranty Applied" 
                      name="warranty_filter" 
                      domain="[('warranty', '=', True)]"/>
              
              <separator/>

              <filter string="Completed" 
                      name="completed_filter" 
                      domain="[('status', '=', 'completed')]"/>
                      
              <filter string="In Progress" 
                      name="progress_filter" 
                      domain="[('status', '=', 'in_progress')]"/>
              
              <filter string="Received" 
                      name="received_filter" 
                      domain="[('status', '=', 'received')]"/>

              <group expand="0" string="Group By">
                  <filter string="Status" 
                          name="group_by_status" 
                          context="{'group_by': 'status'}"/>
              </group>

          </search>
      </field>
    </record>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="workshop_list">
      <field name="name">workshop list</field>
      <field name="model">workshop.workshop</field>
      <field name="arch" type="xml">
        <list>
          <field name="id" string="ID"/>
          <field name="name"/>
          <field name="status"/>
          <field name="warranty"/>
          <field name="reception_date"/>
          <field name="completion_date"/>
          <field name="labor_cost"/>
          <field name="repair_parts_cost"/>
          <field name="repair_total_cost"/>
        </list>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="workshop_form">
      <field name="name">Workshop Form</field>
      <field name="model">workshop.workshop</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group string="General Information">
              <field name="name" placeholder="Device Name" readonly="status != 'received'"/>
              <field name="description" placeholder="Diagnosis" readonly="status == 'completed'"/>
              <field name="warranty" readonly="status != 'received'"/>
            </group>

            <group string="Reception Information">
              <field name="reception_date" placeholder="Reception Date" readonly="status != 'received'"/>
              <field name="completion_date" placeholder="Completion Date" readonly="status == 'completed'" invisible="status == 'received'"/>
              <header>             
                <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
              </header>
            </group>

            <group string="Costos de Reparación">
              <field name="labor_cost" readonly="warranty == True or status == 'completed'" placeholder="Labor Cost"/>
              <notebook>
                <page string="Parts">
                  <field name="parts_ids" readonly="warranty == True or status == 'completed'"/>
                </page>
              </notebook>
              <field name="repair_parts_cost" readonly="True"/>
              <field name="repair_total_cost" readonly="True"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="workshop_action_window">
      <field name="name">Workshop Manager</field>
      <field name="res_model">workshop.workshop</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- server action to the one above -->
<!--
    <record model="ir.actions.server" id="workshop.action_server">
      <field name="name">workshop server</field>
      <field name="model_id" ref="model_workshop_workshop"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->
    <menuitem name="workshop" id="menu_root"/>
    <menuitem name="Orders" id="menu_orders" parent="menu_root" action="workshop_action_window"/>

  </data>
</odoo>
